APP_ENV=development
ALLOW_DEMO_IDENTITY=false
ALLOW_DESTRUCTIVE_SEED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 根 compose.yaml 的非敏感插值。完整 Compose 的密码由
# scripts/init-compose-secrets.sh 生成，以下配置不应包含任何密钥。
DEPLOYMENT_VERSION=compose-local
IMAGE_TAG=local
API_PORT=8000
WEB_PORT=3000
POSTGRES_HOST_PORT=15432
COMPOSE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=customer-care-admin
S3_BUCKET=customercare

POSTGRES_DB=customer_care
POSTGRES_USER=customer_care_app
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://customer_care_app:replace-with-local-postgres-password@127.0.0.1:15432/customer_care

REDIS_PORT=16379
REDIS_URL=redis://127.0.0.1:16379/0

# 客户会话（步骤 32；每位客户在时间窗口内的消息上限）
CONVERSATION_MESSAGE_RATE_LIMIT=20
CONVERSATION_MESSAGE_RATE_WINDOW_SECONDS=60

# 客户 R0 自助 FAQ（步骤 33）：主开关默认关闭；还需要主管在租户开关中显式灰度客户。
# 仅可使用公开、可引用资料；不要把真实客户或生产范围写入本地示例配置。
R0_SELF_SERVICE_MASTER_ENABLED=false
R0_SELF_SERVICE_PRODUCT=demo-support
R0_SELF_SERVICE_LANGUAGE=zh-CN

MINIO_ROOT_USER=customer_care_local_admin
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ENDPOINT_URL=http://127.0.0.1:19000

LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# 完整本地 Compose 固定使用 Mock；真实 Shopify 沙箱由 API 专用命令单独验收。
CUSTOMER_TOOLS_PROVIDER=mock

# 浏览器可见变量，只能放公开配置，不能放密钥
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
