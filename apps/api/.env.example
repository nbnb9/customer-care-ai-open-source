# 应用
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Demo header 身份可被任意调用者伪造；仅本机演示时显式开启
ALLOW_DEMO_IDENTITY=false
# seed 会清空本地应用表；仅在明确需要重置合成数据时临时设为 true
ALLOW_DESTRUCTIVE_SEED=false
# 逗号分隔的完整 Origin；禁止 *、凭据、路径和查询参数
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 在 JSON 解析前拒绝超过此大小的请求体；范围 1024–33554432 字节
MAX_REQUEST_BODY_BYTES=4194304

# 步骤 39：仅保存脱敏的关联元数据；生产发布必须覆盖本机默认版本。
DEPLOYMENT_VERSION=local-dev
OBSERVABILITY_TRACE_RETENTION_HOURS=72

# 数据库
DATABASE_URL=postgresql+psycopg://customer_care_app:replace-with-local-postgres-password@127.0.0.1:15432/customer_care

# Redis
REDIS_URL=redis://127.0.0.1:16379/0

# 对象存储
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_ACCESS_KEY=customer_care_local_admin
S3_SECRET_KEY=你的密码
S3_BUCKET=customercare

# 知识导入分块（步骤 28；参数会写入 chunk metadata）
KNOWLEDGE_CHUNK_MAX_CHARS=480
KNOWLEDGE_CHUNK_OVERLAP_CHARS=60

# 客户会话（步骤 32；每位客户在时间窗口内的消息上限）
CONVERSATION_MESSAGE_RATE_LIMIT=20
CONVERSATION_MESSAGE_RATE_WINDOW_SECONDS=60

# 客户 R0 自助 FAQ（步骤 33）：主开关默认关闭；租户主管仍需显式设置数据库灰度名单。
R0_SELF_SERVICE_MASTER_ENABLED=false
R0_SELF_SERVICE_PRODUCT=demo-support
R0_SELF_SERVICE_LANGUAGE=zh-CN

# LLM
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# 步骤 41.5：默认 Mock。真实 Shopify Dev Store 只读验证时才改为
# shopify_sandbox；三个文件必须使用绝对路径并保持 0600 权限。
CUSTOMER_TOOLS_PROVIDER=mock
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID_FILE=
SHOPIFY_CLIENT_SECRET_FILE=
SHOPIFY_SANDBOX_BINDINGS_FILE=
SHOPIFY_TIMEOUT_SECONDS=8
# 当前代码没有 Shopify 写适配器；设置 true 会 fail-fast。
SHOPIFY_EXTERNAL_WRITES_ENABLED=false
